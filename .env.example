# ── 인증키 ────────────────────────────────────────────────
# 공공데이터포털(data.go.kr)에서 발급받은 일반 인증키.
# Encoding / Decoding 어느 형태든 그대로 붙여넣으면 됩니다.
MFDS_API_KEY=

# ── 요청주소 (선택) ───────────────────────────────────────
# 여기에 넣어두면 config/settings.toml 보다 우선 적용됩니다.
# .env 는 배포 파일에 포함되지 않으므로, 프로그램을 갱신해도 값이 보존됩니다.
#
# 포털 마이페이지 > 활용신청 상세의 '요청주소'가
#   http://apis.data.go.kr/1471000/AaaService01/getAaaInq01  라면
#   MFDS_BASE_URL=http://apis.data.go.kr/1471000/AaaService01
#   MFDS_ENDPOINT=/getAaaInq01
#
# (전체 주소를 MFDS_BASE_URL 에 넣고 MFDS_ENDPOINT 를 비워도 자동 분리됩니다.)
MFDS_BASE_URL=
MFDS_ENDPOINT=
